# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rubber_trader_db

# Express server
PORT=4000

# Source 8 — Commodities-API (commodities-api.com)
# Free tier: 1 req/min, 60-min updates. Get key at https://commodities-api.com
# Optional — Bangkok RSS3 price falls back to Rubber Board international price if not set
COMMODITIES_API_KEY=your_commodities_api_key_here

# Purchase rate emails — sent to customers with an email on file whenever the
# admin saves a day's purchase rate. Optional — sending silently no-ops (with a
# server-log warning) until these are set.
# For Gmail: use smtp.gmail.com / port 465, SMTP_USER = your Gmail address, and
# SMTP_PASS = a 16-character Google App Password (not your normal password) —
# create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM="Rubber Trader <your_gmail_address@gmail.com>"
