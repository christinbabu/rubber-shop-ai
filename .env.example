# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rubber_trader_db

# Express server
PORT=4000

# Source 8 — Commodities-API (commodities-api.com)
# Free tier: 1 req/min, 60-min updates. Get key at https://commodities-api.com
# Optional — Bangkok RSS3 price falls back to Rubber Board international price if not set
COMMODITIES_API_KEY=your_commodities_api_key_here
